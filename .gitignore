# Local datasets (too large for git; keep folder placeholders)
data/raw/*
!data/raw/.gitkeep
!data/raw/tiny-genimage/
data/raw/tiny-genimage/**
!data/raw/tiny-genimage/SOURCE.md
data/pilot/*
!data/pilot/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/controlled_v1/
data/processed/controlled_v1/**
!data/processed/controlled_v1/SOURCE.md

# Common large binary artefacts if they appear outside data/
*.h5
*.hdf5
*.ckpt
*.pt
*.pth
*.onnx
